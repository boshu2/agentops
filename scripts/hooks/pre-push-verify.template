#!/bin/sh
# shellcheck shell=sh
# >>> AGENTOPS-VERIFY-RATCHET (managed by `ao verify init`; edits inside are overwritten) >>>
# Portable pre-push verdict ratchet — installed into .git/hooks/pre-push by
# `ao verify init` (age-rk3r.6). The sovereign local complement to CI: it refuses
# any push to main/master whose commits lack a CONFIRMED cross-family verdict (or
# the provenance-only #trivial waiver). No repo-local script is trusted — the hook
# resolves the AgentOps `ao` binary and delegates the whole gate to IT (the
# aoBinaryInside boundary), so a repo under review cannot subvert its own gate.
#
# SOURCE OF TRUTH: scripts/hooks/pre-push-verify.template in the agentops repo,
# embedded into the ao binary. Do NOT hand-edit the installed copy — re-run
# `ao verify init` to refresh, `ao verify init --remove` to uninstall (which
# restores any pre-existing hook byte-identically).
#
# HOSTILE-PATH HARDENING (round-4 twin of the gate's trusted-git resolution).
# git runs this hook with cwd = the repo worktree, so an operator PATH carrying a
# repo-internal entry (e.g. a direnv-style $PWD/bin) could shadow the utilities
# this script itself runs — a planted `cat` that swallows stdin would turn the
# gate into a "no pre-push stdin" skip (fail-open). Two measures:
#   - the shebang is /bin/sh (absolute, POSIX-standard), NOT `/usr/bin/env sh`,
#     so the interpreter itself is never PATH-resolved;
#   - standard system dirs are prepended below so cat/mktemp/dirname resolve
#     from /usr/bin:/bin first, never a repo-internal shadow. The ao binary is
#     unaffected (it is the ONLY-accepted install-time baked absolute path — see
#     the invariant below); the gate re-sanitizes its own PATH internally for
#     every git call.
set -u
PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export PATH

# The ledger-reader capability floor this hook requires (age-rk3r.6). Kept in
# lockstep with provenancegraph.LedgerReaderVersion; bumped only when a newer
# ledger record shape needs a newer reader.
REQUIRED_LEDGER_READER=1

# INVARIANT (convergence-by-deletion, age-rk3r.6): The hook trusts EXACTLY the
# install-time baked absolute binary. No PATH resolution, no repo-relative, no
# repo-internal-absolute — a missing baked binary refuses the push (reinstall),
# it never falls back. This deletes the planted-binary class rather than patching
# each vector.
#
# @@AO_BIN@@ is substituted by `ao verify init` with the absolute path of the
# installing binary and is the ONLY accepted ao: the `command -v ao` PATH
# fallback and the AGENTOPS_AO_BIN override were DELETED so a hostile repo has
# nothing to plant into. A stale install (baked path gone) fails closed.
AO="@@AO_BIN@@"
case "$AO" in
	/*) : ;; # absolute — the only acceptable form
	*)
		echo "ao verify hook: no absolute ao path is baked into this hook; reinstall it with 'ao verify init' — refusing push (fail-closed)." >&2
		exit 1
		;;
esac
if [ ! -x "$AO" ]; then
	echo "ao verify hook: the installed ao binary is missing at $AO; reinstall the hook with 'ao verify init' — refusing push (fail-closed)." >&2
	echo "          (an urgent push can bypass this hook with 'git push --no-verify')." >&2
	exit 1
fi

# Capture git's pre-push stdin ONCE so both a chained original hook and the ao
# gate can each read the full record set.
_ao_stdin=$(mktemp "${TMPDIR:-/tmp}/ao-prepush.XXXXXX") || {
	echo "pre-push: cannot allocate a temp file for stdin — refusing push (fail-closed)." >&2
	exit 1
}
# A write failure here (ENOSPC, ulimit -f / SIGXFSZ, EFBIG) would leave an empty
# or truncated capture; `ao verify pre-push` reads an empty stdin as a NON-hook
# invocation and exits 0 — a fail-OPEN for an unverified push. Refuse fail-closed
# if the capture does not complete cleanly.
if ! cat >"$_ao_stdin"; then
	echo "pre-push: failed to capture git's pre-push stdin (disk full / file-size limit?) — refusing push (fail-closed)." >&2
	rm -f "$_ao_stdin" 2>/dev/null || true
	exit 1
fi
_ao_cleanup() { rm -f "$_ao_stdin" 2>/dev/null || true; }
trap _ao_cleanup EXIT
trap '_ao_cleanup; exit 130' INT
trap '_ao_cleanup; exit 143' TERM

# Chain a pre-existing hook, if `ao verify init` set one aside. It runs FIRST with
# the same args + the captured stdin; its non-zero exit refuses the push.
unset CDPATH 2>/dev/null || true
_ao_hookdir=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
if [ -n "$_ao_hookdir" ] && [ -x "$_ao_hookdir/pre-push.agentops-orig" ]; then
	"$_ao_hookdir/pre-push.agentops-orig" "$@" <"$_ao_stdin" || exit $?
fi

# ao-version FLOOR: a binary too old to understand the current ledger record
# shapes would report a FALSE broken chain, so refuse-with-upgrade instead. Probe
# via a NON-forwarding subcommand so an ancient ao answers cleanly (a pre-age-rk3r.6
# ao lacking it exits non-zero → treated as too old) rather than misrouting into
# the review engine.
_ao_reader=$("$AO" provenance ledger-reader-version 2>/dev/null || echo 0)
case "$_ao_reader" in
	*[!0-9]* | "") _ao_reader=0 ;; # non-integer / empty → treat as too old
esac
if [ "$_ao_reader" -lt "$REQUIRED_LEDGER_READER" ]; then
	echo "pre-push: ao too old for this ledger; upgrade ao (need ledger-reader >= $REQUIRED_LEDGER_READER, have $_ao_reader) — refusing push (fail-closed)." >&2
	exit 1
fi

# Delegate the whole verdict + chain gate to the trusted ao binary. Forward git's
# hook args ("$@" = <remote-name> <remote-url>) so the gate can scope "already
# verified" to the TARGET remote's trunk, not any remote's same-named branch.
"$AO" verify pre-push "$@" <"$_ao_stdin"
exit $?
# <<< AGENTOPS-VERIFY-RATCHET <<<
