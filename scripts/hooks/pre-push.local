#!/usr/bin/env sh
# AgentOps cockpit pre-push gate (P1.2 / ag-qidx.2)
#
# Source of truth: scripts/hooks/pre-push.local (tracked).
# Installed copy: $(git rev-parse --git-common-dir)/hooks/pre-push.local
# Install / reinstall: scripts/install-pre-push-gate.sh
#
# Runs the fast cockpit smoke (`ao gate check --fast`) before every push; on
# pushes to main/master it also runs the full race suite and pawl verdict check.
# BLOCKS the push on failure (gate exits 1).
#
# Mechanical enforcement (pre-mortem HIGH "discipline is not a mechanism"):
# the ONLY bypass is the audited AGENTOPS_GATE_DISABLED=1, which is logged.
# This mirrors the LAW 0 no-claude-p guard pattern.
set -u

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
common=$(git rev-parse --git-common-dir 2>/dev/null)

# Capture pre-push stdin (local_ref local_sha remote_ref remote_sha) when git
# invokes this hook. Empty when run standalone (ao gate check path) — the pawl
# check skips cleanly in that case (age-58o).
prepush_stdin=""
_agentops_push_lock=""
if [ ! -t 0 ]; then
    prepush_stdin=$(mktemp "${TMPDIR:-/tmp}/agentops-prepush-stdin.XXXXXX" 2>/dev/null) || prepush_stdin=""
    if [ -n "$prepush_stdin" ]; then
        cat >"$prepush_stdin" || prepush_stdin=""
    fi
fi
cleanup_prepush_stdin() {
    [ -n "$prepush_stdin" ] && rm -f "$prepush_stdin" 2>/dev/null || true
    # Release the serial push lock (age-2sog) if this run acquired it.
    [ -n "$_agentops_push_lock" ] && rmdir "$_agentops_push_lock" 2>/dev/null || true
}
trap cleanup_prepush_stdin EXIT

if [ "${AGENTOPS_GATE_DISABLED:-0}" = "1" ]; then
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)
    sha=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
    printf '%s\t%s\t%s\t%s\tpre-push-gate-bypassed\n' \
        "$ts" "${USER:-unknown}" "$branch" "$sha" \
        >> "${common}/agentops-gate-bypass.log" 2>/dev/null || true
    echo >&2 "⚠ AgentOps pre-push gate BYPASSED (AGENTOPS_GATE_DISABLED=1) — logged to agentops-gate-bypass.log"
    exit 0
fi

# Serialize concurrent local pushes (age-2sog / push-serial.sh). Two agents
# pushing at the same instant run the gate — and touch shared generated surfaces
# (registry.json, runtime ledgers) + the shared race-test build — simultaneously,
# which can corrupt them. Hold a within-host advisory lock for the gate's duration
# (mkdir is atomic; flock is absent on macOS); cleanup_prepush_stdin releases it.
# FAIL-CLOSED: if the lock can't be acquired within the timeout, refuse the push
# rather than gate unserialized. (Cross-host serialization is git's own atomic
# non-fast-forward rejection + rebase-retry; no shared lock spans hosts.)
_agentops_lock_dir="${TMPDIR:-/tmp}/agentops-push.lock"
_agentops_lock_timeout="${AGENTOPS_PUSH_LOCK_TIMEOUT:-300}"
_agentops_lock_waited=0
while ! mkdir "$_agentops_lock_dir" 2>/dev/null; do
    if [ "$_agentops_lock_waited" -ge "$_agentops_lock_timeout" ]; then
        echo >&2 "✗ pre-push: timed out after ${_agentops_lock_timeout}s waiting for the serial push lock (${_agentops_lock_dir})."
        echo >&2 "  Another local push is gating. If none is, remove the stale lock dir and retry."
        exit 1
    fi
    [ "$_agentops_lock_waited" -eq 0 ] && echo >&2 "pre-push: another local push is gating — waiting for the serial lock (age-2sog)…"
    sleep 2
    _agentops_lock_waited=$((_agentops_lock_waited + 2))
done
_agentops_push_lock="$_agentops_lock_dir"

# --- bash gate (escape hatch) ------------------------------------------------
# AGENTOPS_GATE_BASH=1 routes through the legacy bash gate (scripts/pre-push-gate.sh)
# instead of the Go orchestrator. Kept during the transition; remove once the bash
# gate is retired (ag-3n71 PB2 tail).
if [ "${AGENTOPS_GATE_BASH:-0}" = "1" ]; then
    gate="${toplevel}/scripts/pre-push-gate.sh"
    [ -x "$gate" ] && exec "$gate" --fast
    echo >&2 "AgentOps: bash gate requested but ${gate} missing — skipping"
    exit 0
fi

# --- DEFAULT: Go gate (ao gate check) ----------------------------------------
# Flipped to default in PB2 once the registry reached coverage parity (gated by
# the coverage-equivalence test). From-source bootstrap so the gate that checks
# Go compiles can never run a stale `ao` (pre-mortem BLOCKER-3): prove
# compilation first (block with the build error if broken), then build a fresh
# ao and exec it.
if ! ( cd "${toplevel}/cli" && go build ./... ); then
    echo >&2 "✗ go build ./... failed — fix compilation before pushing (ao gate cannot run on broken Go)"
    exit 1
fi
if ! ( cd "${toplevel}/cli" && go build -o /tmp/ao-gate ./cmd/ao ); then
    echo >&2 "✗ could not build ao for the gate"
    exit 1
fi

# Trunk-bound provenance for commits already on origin/main (age-0tn, one-push lag).
if [ -x "${toplevel}/scripts/post-land-provenance-emit.sh" ]; then
    AO_BIN=/tmp/ao-gate bash "${toplevel}/scripts/post-land-provenance-emit.sh" || true
fi

# Run the gate (no longer exec'd) so the SENSOR feed can fire after a PASS.
/tmp/ao-gate gate check --fast
gate_status=$?

# FULL-SUITE race gate on push-to-main (age-push-equals-ci-0ua.1). The gate
# above runs `--fast` = CHANGED-scope tests only, so a latent red in an
# UNTOUCHED package is invisible — exactly how cmd/ao shipped red for 281
# commits. Push-to-main is the SOLE routine CI authority (GHA is a tag/PR/manual
# backstop), so it must run the WHOLE suite, not just the diff. Measured ~77s
# for all packages (-race parallelizes; cmd/ao is the long pole). The in-loop
# `ao gate check --fast --scope head` path is unchanged (fast iteration).
# Emergency bypass: AGENTOPS_PREPUSH_SKIP_FULL_RACE=1 (use only with cause).
if [ "$gate_status" -eq 0 ] && [ -n "$prepush_stdin" ] && [ -s "$prepush_stdin" ] \
   && [ "${AGENTOPS_PREPUSH_SKIP_FULL_RACE:-0}" != "1" ] \
   && awk '{print $3}' "$prepush_stdin" | grep -qE '^refs/heads/(main|master)$'; then
    # Randomized order is part of the local release membrane: the push-to-main
    # door must catch cross-package isolation leaks that a fixed seed hides.
    # The old seed-1 compromise was removed after age-cmdao proved shuffle=2 and
    # multiple -shuffle=on cmd/ao runs no longer mutate core.bare.
    echo "pre-push: push-to-main — running FULL race suite (go test ./... -race -shuffle=on, ~77s)" >&2
    # Scrub git's hook-injected discovery env (age-ngtc). git runs pre-push hooks
    # with GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE/... pointing at the pushing repo —
    # and when the push ORIGINATES FROM A LINKED WORKTREE those point at the
    # worktree gitdir. ~10 git-aware test packages (TestGetRepoRoot, TestRemoveWorktree,
    # TestRepairSharedCoreWorktreeConfig, TestParseTimeline_IgnoresPollutedGitDiscoveryEnv,
    # ...) build fixture repos in temp dirs and shell out to git; the inherited env
    # makes those git ops hit the REAL repo (exit 128), so the gate refused every
    # worktree-origin push — hostile to the worktree-isolation workflow. Unsetting
    # is idempotent (harmless for main-checkout pushes).
    if ! ( cd "${toplevel}/cli" \
        && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE \
        && go test ./... -race -shuffle=on -count=1 ); then
        echo >&2 "✗ FULL race suite FAILED — a package outside the changed set is red; push refused (age-push-equals-ci-0ua.1)"
        gate_status=1
    fi
fi

# Pawl gate (age-58o): push-to-main requires CONFIRMED pawl verdict bound to
# the landing commit. Runs only when git supplied pre-push stdin (not during
# standalone `ao gate check`). Skip: AGENTOPS_PREPUSH_SKIP_PAWL=1.
if [ "$gate_status" -eq 0 ] && [ -n "$prepush_stdin" ] && [ -s "$prepush_stdin" ] \
   && [ -x "${toplevel}/scripts/check-pawl-pre-push.sh" ]; then
    bash "${toplevel}/scripts/check-pawl-pre-push.sh" <"$prepush_stdin" || gate_status=$?
fi

# Pre-push emit records local OIDs that may never reach origin/main (age-0tn).
# Trunk-bound emission is the default via post-land-provenance-emit.sh above.
# Legacy pre-push feed remains opt-in via AGENTOPS_PROVENANCE_EMIT_PRE_PUSH=1.
if [ "$gate_status" -eq 0 ] \
   && [ "${AGENTOPS_PROVENANCE_EMIT_PRE_PUSH:-0}" = "1" ] \
   && [ -x "${toplevel}/scripts/emit-landed-provenance.sh" ]; then
    AO_BIN=/tmp/ao-gate bash "${toplevel}/scripts/emit-landed-provenance.sh" || true
fi

# DETERMINISTIC-TIER SENSOR feed (age-srl): symmetric to the PASS-branch
# provenance feed above. When the gate BLOCKED, the deterministic membrane just
# caught a false-done — record it as a REFUTED gate-verdict so the in-situ
# catch-rate (ao yield gauge) stops undercounting the deterministic tier.
# Non-blocking and skippable; never changes gate_status.
if [ "$gate_status" -ne 0 ] && [ -x "${toplevel}/scripts/emit-deterministic-catch.sh" ]; then
    AO_BIN=/tmp/ao-gate bash "${toplevel}/scripts/emit-deterministic-catch.sh" || true
fi
exit "$gate_status"
