#!/usr/bin/env bash
# bd-shim v1
# bd-hooks-version: 0.49.3
#
# Pre-push hook: delegates to bd for issue tracking.
#
# Historical bd shim. This tracked .githooks directory is not the live AgentOps
# cockpit gate on current installs; core.hooksPath points at .git/hooks, where
# scripts/install-pre-push-gate.sh chains scripts/hooks/pre-push.local.
# The old CI-only gate decision in local-pre-push-gate-retirement.md is
# superseded. Current direct-main release authority is local pre-push + ao gate
# + full randomized race + pawl check; GitHub Actions are tag/PR/manual backstop.

set -euo pipefail

HOOK_STDIN_FILE="$(mktemp)"

cleanup() {
    rm -f "$HOOK_STDIN_FILE"
}
trap cleanup EXIT

cat >"$HOOK_STDIN_FILE"

run_without_git_env() {
    local var_name
    local -a env_args=(env)
    while IFS='=' read -r var_name _; do
        [[ "$var_name" == GIT_* ]] || continue
        env_args+=("-u" "$var_name")
    done < <(env)
    "${env_args[@]}" "$@"
}

# --- bd issue tracking (existing behavior) ---
if command -v bd >/dev/null 2>&1; then
    run_without_git_env bd hooks run pre-push "$@" <"$HOOK_STDIN_FILE"
fi
