{
  "agentops-command-guards": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "dcg",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.agents/ao/hooks/skill-first-coord-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
