{
  "agentops-dcg": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "dcg",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ao handoff --help >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "agentops-evidence-surface": {
    "Stop": [
      {
        "type": "command",
        "command": "ao handoff --help >/dev/null 2>&1 || true",
        "timeout": 10
      }
    ]
  }
}
