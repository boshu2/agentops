{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentops run-packet failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "command",
    "action",
    "packet_id",
    "role",
    "provider",
    "outcome",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "gc-execution-result.v1"},
    "ok": {"const": false},
    "command": {"const": "agentops run-packet"},
    "action": {"const": "error"},
    "packet_id": {"type": "string"},
    "role": {"enum": ["implement", "validate", "unknown"]},
    "provider": {"enum": ["codex", "claude", "unknown"]},
    "outcome": {"const": "error"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
