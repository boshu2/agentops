{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/initial-delivery-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_digest", "node_id", "semantic_bead_id", "terminal_digest", "certificate_digest", "delivery_manifest_content_digest", "native_context_digest", "handoff_id", "delivery_bead_id", "external_ref", "mode", "created_at"],
  "properties": {
    "schema_version": {"const": "initial-delivery-receipt.v1"},
    "program_digest": {"$ref": "#/$defs/digest"},
    "node_id": {"type": "string", "minLength": 1},
    "semantic_bead_id": {"type": "string", "minLength": 1},
    "terminal_digest": {"$ref": "#/$defs/digest"},
    "certificate_digest": {"$ref": "#/$defs/digest"},
    "delivery_manifest_content_digest": {"$ref": "#/$defs/digest"},
    "native_context_digest": {"$ref": "#/$defs/digest"},
    "handoff_id": {"$ref": "#/$defs/digest"},
    "delivery_bead_id": {"type": "string", "minLength": 1},
    "external_ref": {"type": "string", "minLength": 1},
    "mode": {"enum": ["auto", "manual"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
