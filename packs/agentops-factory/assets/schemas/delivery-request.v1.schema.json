{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/delivery-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "admission_certificate_ref", "admission_certificate_digest", "subject_manifest_ref", "subject_manifest_digest", "native_context_ref", "native_context_digest", "semantic_bead_id", "semantic_terminal_ref", "rig_id", "repository", "remote", "epoch", "mode", "deadline", "prepared_at", "committed_at", "base_ref", "base_oid"],
  "properties": {
    "schema_version": {"const": "delivery-request.v1"},
    "admission_certificate_ref": {"$ref": "#/$defs/ref"},
    "admission_certificate_digest": {"$ref": "#/$defs/digest"},
    "subject_manifest_ref": {"$ref": "#/$defs/ref"},
    "subject_manifest_digest": {"$ref": "#/$defs/digest"},
    "native_context_ref": {"$ref": "#/$defs/ref"},
    "native_context_digest": {"$ref": "#/$defs/digest"},
    "semantic_bead_id": {"type": "string", "minLength": 1},
    "semantic_terminal_ref": {"type": "string", "minLength": 1},
    "rig_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "remote": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["auto", "manual"]},
    "deadline": {"type": "string", "format": "date-time"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "committed_at": {"type": "string", "format": "date-time"},
    "base_ref": {"type": "string", "minLength": 1},
    "base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+"}
  }
}
