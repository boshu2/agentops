{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://agentops.local/schemas/epoch-receipt.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","handoff_id","epoch","repository","remote","base_ref","observed_base_oid","candidate","subject_manifest_digest","path_proof","branch","epoch_head","epoch_tree"],"properties":{"schema_version":{"const":"epoch-receipt.v1"},"handoff_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"epoch":{"type":"integer","minimum":1},"repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},"remote":{"type":"string","minLength":1},"base_ref":{"type":"string","minLength":1},"observed_base_oid":{"type":"string","pattern":"^[0-9a-f]{40}$"},"candidate":{"type":"string","pattern":"^[0-9a-f]{40}$"},"subject_manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"path_proof":{"type":"string","pattern":"^[0-9a-f]{64}$"},"branch":{"type":"string","pattern":"^gc/delivery/[0-9a-f]{20}$"},"lease_oid":{"type":"string","pattern":"^[0-9a-f]{40}$"},"epoch_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},"epoch_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}}}
