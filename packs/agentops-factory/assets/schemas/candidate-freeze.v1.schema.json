{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/candidate-freeze.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "program_digest", "node_id", "semantic_bead_id", "implement_packet_digest", "intent_digest", "base_oid", "author_context_id", "baseline_manifest", "baseline_manifest_digest", "subject_manifest", "subject_manifest_digest", "delivery_manifest", "delivery_manifest_digest", "delivery_manifest_content_digest", "scope_receipt", "scope_receipt_digest", "changed_paths", "candidate", "created_at"],
  "properties": {
    "schema_version": {"const": "candidate-freeze.v1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_digest": {"$ref": "#/$defs/digest"},
    "node_id": {"type": "string", "minLength": 1},
    "semantic_bead_id": {"type": "string", "minLength": 1},
    "implement_packet_digest": {"$ref": "#/$defs/digest"},
    "intent_digest": {"$ref": "#/$defs/digest"},
    "base_oid": {"$ref": "#/$defs/oid"},
    "author_context_id": {"type": "string", "minLength": 1},
    "baseline_manifest": {"$ref": "#/$defs/absolutePath"},
    "baseline_manifest_digest": {"$ref": "#/$defs/digest"},
    "subject_manifest": {"$ref": "#/$defs/absolutePath"},
    "subject_manifest_digest": {"$ref": "#/$defs/digest"},
    "delivery_manifest": {"$ref": "#/$defs/absolutePath"},
    "delivery_manifest_digest": {"$ref": "#/$defs/digest"},
    "delivery_manifest_content_digest": {"$ref": "#/$defs/digest"},
    "scope_receipt": {"$ref": "#/$defs/absolutePath"},
    "scope_receipt_digest": {"$ref": "#/$defs/digest"},
    "changed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "content_digest"],
      "properties": {
        "commit": {"$ref": "#/$defs/oid"},
        "tree": {"$ref": "#/$defs/oid"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "absolutePath": {"type": "string", "pattern": "^/"}
  }
}
