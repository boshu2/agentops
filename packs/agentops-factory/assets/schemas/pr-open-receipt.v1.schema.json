{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/pr-open-receipt.v1.schema.json",
  "title": "GC33 immutable forge PR open/adopt receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_digest", "handoff_id", "epoch", "rig_id", "repository", "remote", "pr_id", "branch", "base_ref", "expected_base_oid", "observed_base_oid", "expected_head", "observed_head", "effect_id", "node_id", "number", "url", "state", "draft", "outcome", "response_digest"],
  "properties": {
    "schema_version": {"const": "pr-open-receipt.v1"},
    "intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handoff_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "epoch": {"type": "integer", "minimum": 1},
    "rig_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "remote": {"type": "string", "minLength": 1},
    "pr_id": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "pattern": "^gc/delivery/[0-9a-f]{20}$"},
    "base_ref": {"type": "string", "minLength": 1},
    "expected_base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "effect_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_id": {"type": "string", "minLength": 1},
    "number": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "url": {"type": "string", "format": "uri"},
    "state": {"const": "open"},
    "draft": {"const": false},
    "outcome": {"enum": ["applied", "already_applied", "updated"]},
    "response_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
