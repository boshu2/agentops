{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/gc-delivery-native-context.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rig_id", "repository", "repository_dir", "worktree_root", "beads_dir", "remote", "base_ref", "successor_capability_digest", "toolchain_lock_digest", "toolchain_receipt_path", "toolchain_receipt_digest", "beads_representation", "executables", "check_only_gate_argv"],
  "properties": {
    "schema_version": {"const": "gc-delivery-native-context.v1"},
    "rig_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "repository_dir": {"$ref": "#/$defs/absolute_path"},
    "worktree_root": {"$ref": "#/$defs/absolute_path"},
    "beads_dir": {"$ref": "#/$defs/absolute_path"},
    "remote": {"type": "string", "minLength": 1},
    "base_ref": {"type": "string", "minLength": 1},
    "successor_capability_digest": {"$ref": "#/$defs/digest"},
    "toolchain_lock_digest": {"$ref": "#/$defs/digest"},
    "toolchain_receipt_path": {"$ref": "#/$defs/absolute_path"},
    "toolchain_receipt_digest": {"$ref": "#/$defs/digest"},
    "beads_representation": {"const": "B-successor-delivery-bead"},
    "executables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gc", "bd", "git", "gh", "bash", "agentops-gc-delivery"],
      "properties": {
        "gc": {"$ref": "#/$defs/executable"},
        "bd": {"$ref": "#/$defs/executable"},
        "git": {"$ref": "#/$defs/executable"},
        "gh": {"$ref": "#/$defs/executable"},
        "bash": {"$ref": "#/$defs/executable"},
        "agentops-gc-delivery": {"$ref": "#/$defs/executable"}
      }
    },
    "check_only_gate_argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/"},
    "executable": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {"path": {"$ref": "#/$defs/absolute_path"}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
