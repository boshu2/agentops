{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/learn-receipt.v1.schema.json",
  "title": "Learn Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "skill",
    "status",
    "input_verdict_ref",
    "input_verdict_digest",
    "artifact",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": "learn-receipt.v1"},
    "phase": {"const": "learn"},
    "skill": {"const": "learn"},
    "status": {"enum": ["DONE", "PARTIAL", "BLOCKED"]},
    "input_verdict_ref": {"type": "string", "minLength": 1},
    "input_verdict_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "evidence_ref", "disposition"],
        "properties": {
          "kind": {"enum": ["finding", "coverage-gap", "strength", "process-signal"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["record", "candidate", "no_change"]}
        }
      }
    },
    "next_action": {"type": "string"}
  }
}
