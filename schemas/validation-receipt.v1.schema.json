{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/validation-receipt.v1.schema.json",
  "title": "Deterministic validation request receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "candidate",
    "validator_route",
    "preflight_errors",
    "gate_executions",
    "model_spend_allowed",
    "disposition",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/digest" },
    "candidate": { "$ref": "validation-candidate.v1.schema.json" },
    "validator_route": { "const": "single_fresh" },
    "preflight_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/preflightError" }
    },
    "gate_executions": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateExecution" }
    },
    "model_spend_allowed": { "type": "boolean" },
    "disposition": { "enum": ["READY", "REPAIR", "NOTE", "BLOCK"] },
    "next_action": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "preflight_errors": { "minItems": 1 } },
        "required": ["preflight_errors"]
      },
      "then": {
        "properties": {
          "gate_executions": { "maxItems": 0 },
          "model_spend_allowed": { "const": false },
          "disposition": { "const": "BLOCK" },
          "next_action": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "READY" } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "preflight_errors": { "maxItems": 0 },
          "gate_executions": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/readyExecution" },
            "contains": {
              "properties": {
                "lane": { "const": "mandatory" },
                "candidate": {
                  "properties": { "status": { "const": "PASS" } },
                  "required": ["status"]
                }
              },
              "required": ["lane", "candidate"]
            }
          },
          "model_spend_allowed": { "const": true },
          "next_action": { "const": "VALIDATE_SINGLE_FRESH" }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "REPAIR" } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "preflight_errors": { "maxItems": 0 },
          "gate_executions": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/conclusiveExecution" },
            "contains": { "$ref": "#/$defs/mandatoryCandidateIntroduced" }
          },
          "model_spend_allowed": { "const": false },
          "next_action": { "const": "REPAIR_CANDIDATE" }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "NOTE" } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "preflight_errors": { "maxItems": 0 },
          "gate_executions": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/conclusiveExecution" },
            "contains": { "$ref": "#/$defs/mandatoryPreExisting" }
          },
          "model_spend_allowed": { "const": false },
          "next_action": { "const": "RETURN_PRE_EXISTING_FAILURE" }
        }
      }
    },
    {
      "if": {
        "properties": { "disposition": { "const": "BLOCK" } },
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "model_spend_allowed": { "const": false },
          "next_action": { "type": "null" }
        },
        "anyOf": [
          { "properties": { "preflight_errors": { "minItems": 1 } } },
          { "properties": { "gate_executions": { "minItems": 1 } } }
        ]
      }
    },
    {
      "if": {
        "properties": { "model_spend_allowed": { "const": true } },
        "required": ["model_spend_allowed"]
      },
      "then": { "properties": { "disposition": { "const": "READY" } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preflightError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "defect_class", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "defect_class": {
          "enum": [
            "candidate_integrity",
            "evidence_integrity",
            "registry_integrity",
            "toolchain_integrity",
            "validator_integrity",
            "request_integrity"
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "factualResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exit_code", "output_sha256", "facts"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "ERROR", "UNKNOWN"] },
        "exit_code": { "type": "integer" },
        "output_sha256": { "$ref": "#/$defs/digest" },
        "facts": { "type": "object" }
      }
    },
    "gateExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane", "proof_kind", "candidate", "attribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "lane": { "enum": ["mandatory", "diagnostic", "release"] },
        "proof_kind": {
          "enum": [
            "syntax",
            "schema",
            "identity",
            "paths",
            "generated_drift",
            "executable_assertion",
            "evidence_integrity"
          ]
        },
        "candidate": { "$ref": "#/$defs/factualResult" },
        "baseline": { "$ref": "#/$defs/factualResult" },
        "attribution": { "enum": ["not_applicable", "candidate_introduced", "pre_existing"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "attribution": { "const": "candidate_introduced" } },
            "required": ["attribution"]
          },
          "then": {
            "required": ["baseline"],
            "properties": {
              "candidate": {
                "properties": { "status": { "const": "FAIL" } },
                "required": ["status"]
              },
              "baseline": {
                "properties": { "status": { "const": "PASS" } },
                "required": ["status"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "attribution": { "const": "pre_existing" } },
            "required": ["attribution"]
          },
          "then": {
            "required": ["baseline"],
            "properties": {
              "candidate": {
                "properties": { "status": { "const": "FAIL" } },
                "required": ["status"]
              },
              "baseline": {
                "properties": { "status": { "const": "FAIL" } },
                "required": ["status"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidate": {
                "properties": { "status": { "not": { "const": "FAIL" } } },
                "required": ["status"]
              }
            },
            "required": ["candidate"]
          },
          "then": {
            "not": { "required": ["baseline"] },
            "properties": { "attribution": { "const": "not_applicable" } }
          }
        },
        {
          "if": {
            "properties": { "attribution": { "const": "not_applicable" } },
            "required": ["attribution"]
          },
          "then": {
            "oneOf": [
              {
                "not": { "required": ["baseline"] },
                "properties": {
                  "candidate": {
                    "properties": { "status": { "not": { "const": "FAIL" } } },
                    "required": ["status"]
                  }
                }
              },
              {
                "required": ["baseline"],
                "properties": {
                  "candidate": {
                    "properties": { "status": { "const": "FAIL" } },
                    "required": ["status"]
                  },
                  "baseline": {
                    "properties": { "status": { "enum": ["ERROR", "UNKNOWN"] } },
                    "required": ["status"]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "readyExecution": {
      "allOf": [
        { "$ref": "#/$defs/gateExecution" },
        {
          "not": {
            "properties": {
              "candidate": {
                "properties": { "status": { "enum": ["ERROR", "UNKNOWN"] } },
                "required": ["status"]
              }
            },
            "required": ["candidate"]
          }
        },
        {
          "if": {
            "properties": { "lane": { "const": "mandatory" } },
            "required": ["lane"]
          },
          "then": {
            "properties": {
              "candidate": {
                "properties": { "status": { "const": "PASS" } },
                "required": ["status"]
              }
            }
          }
        }
      ]
    },
    "conclusiveExecution": {
      "allOf": [
        { "$ref": "#/$defs/gateExecution" },
        {
          "not": {
            "properties": {
              "candidate": {
                "properties": { "status": { "enum": ["ERROR", "UNKNOWN"] } },
                "required": ["status"]
              }
            },
            "required": ["candidate"]
          }
        }
      ]
    },
    "mandatoryCandidateIntroduced": {
      "properties": {
        "lane": { "const": "mandatory" },
        "candidate": {
          "properties": { "status": { "const": "FAIL" } },
          "required": ["status"]
        },
        "baseline": {
          "properties": { "status": { "const": "PASS" } },
          "required": ["status"]
        },
        "attribution": { "const": "candidate_introduced" }
      },
      "required": ["lane", "candidate", "baseline", "attribution"]
    },
    "mandatoryPreExisting": {
      "properties": {
        "lane": { "const": "mandatory" },
        "candidate": {
          "properties": { "status": { "const": "FAIL" } },
          "required": ["status"]
        },
        "baseline": {
          "properties": { "status": { "const": "FAIL" } },
          "required": ["status"]
        },
        "attribution": { "const": "pre_existing" }
      },
      "required": ["lane", "candidate", "baseline", "attribution"]
    }
  }
}
