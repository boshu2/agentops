{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/ao-state-projection-manifest.v1.schema.json",
  "title": "AgentOps AO State Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ao_state_projection_manifest" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authority_path", "digest"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^finding-[a-z0-9][a-z0-9._-]*$",
            "minLength": 10,
            "maxLength": 120
          },
          "authority_path": {
            "type": "string",
            "pattern": "^\\.ao/accepted/findings/[A-Za-z0-9._-]+\\.json$",
            "not": { "pattern": "(^|/)\\.\\.(/|$)" },
            "maxLength": 300
          },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
