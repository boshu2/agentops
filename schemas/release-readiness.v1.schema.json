{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/release-readiness.v1.schema.json",
  "title": "AgentOps Release Readiness",
  "$comment": "practices: [continuous-delivery, supply-chain-integrity]",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "mode",
    "threshold",
    "release_readiness_score",
    "release_status",
    "dimensions",
    "hil_evidence",
    "evidence",
    "evidence_errors",
    "recommendations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "mode": {
      "type": "string",
      "enum": ["official", "advisory", "fast"]
    },
    "threshold": {
      "type": "number",
      "minimum": 0
    },
    "release_readiness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "release_status": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "artifact_dir": {
      "type": ["string", "null"]
    },
    "dimensions": {
      "type": "object",
      "required": ["sil", "vil", "hil", "artifacts", "security", "evals"],
      "additionalProperties": false,
      "properties": {
        "sil": {
          "$ref": "#/$defs/dimension"
        },
        "vil": {
          "$ref": "#/$defs/dimension"
        },
        "hil": {
          "$ref": "#/$defs/dimension"
        },
        "artifacts": {
          "$ref": "#/$defs/dimension"
        },
        "security": {
          "$ref": "#/$defs/dimension"
        },
        "evals": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "hil_evidence": {
      "type": "object",
      "required": ["status", "artifact", "waiver"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skipped", "waived"]
        },
        "artifact": {
          "type": ["string", "null"]
        },
        "waiver": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["policy", "lanes"],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "object",
          "required": [
            "name",
            "official_mode",
            "status_flags_trusted",
            "pre_publish_blocking",
            "threshold"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "zero-trust-release-evidence"
            },
            "official_mode": {
              "type": "boolean"
            },
            "status_flags_trusted": {
              "type": "boolean"
            },
            "pre_publish_blocking": {
              "type": "boolean"
            },
            "threshold": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "lanes": {
          "type": "object",
          "required": [
            "sil",
            "vil",
            "digital_twin",
            "hil",
            "artifacts",
            "security",
            "evals"
          ],
          "additionalProperties": false,
          "properties": {
            "sil": {
              "$ref": "#/$defs/evidenceLane"
            },
            "vil": {
              "$ref": "#/$defs/evidenceLane"
            },
            "digital_twin": {
              "$ref": "#/$defs/evidenceLane"
            },
            "hil": {
              "$ref": "#/$defs/evidenceLane"
            },
            "artifacts": {
              "$ref": "#/$defs/evidenceLane"
            },
            "security": {
              "$ref": "#/$defs/evidenceLane"
            },
            "evals": {
              "$ref": "#/$defs/evidenceLane"
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "required": ["status", "weight", "points"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skipped", "waived"]
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "evidence_artifact": {
          "type": ["string", "null"]
        }
      }
    },
    "evidenceLane": {
      "type": "object",
      "required": [
        "status",
        "artifact",
        "required",
        "blocking",
        "freshness_required",
        "release_version_required"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skipped", "waived"]
        },
        "artifact": {
          "type": ["string", "null"]
        },
        "evidence_kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "workflow_strength": {
          "type": ["string", "null"]
        },
        "binary_digest": {
          "type": ["string", "null"]
        },
        "target_identity": {
          "type": ["object", "array", "null"]
        },
        "logs": {
          "type": ["object", "null"]
        },
        "waiver": {
          "type": ["string", "null"]
        },
        "required": {
          "type": "boolean"
        },
        "blocking": {
          "type": "boolean"
        },
        "freshness_required": {
          "type": "boolean"
        },
        "release_version_required": {
          "type": "boolean"
        }
      }
    }
  }
}
