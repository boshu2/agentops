{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/validation-request.v1.schema.json",
  "title": "Frozen validation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "candidate",
    "acceptance",
    "evidence",
    "claim_dependencies",
    "claim_dependency_digests",
    "gate_registry",
    "toolchain",
    "selected_gates",
    "author_id",
    "validator"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "candidate": { "$ref": "validation-candidate.v1.schema.json" },
    "acceptance": { "$ref": "#/$defs/fileIdentity" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileIdentity" },
      "uniqueItems": true
    },
    "claim_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileIdentity" },
      "uniqueItems": true
    },
    "claim_dependency_digests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/digest" },
      "uniqueItems": true
    },
    "gate_registry": { "$ref": "#/$defs/fileIdentity" },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileIdentity" },
      "uniqueItems": true
    },
    "selected_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/selectedGate" },
      "uniqueItems": true
    },
    "author_id": { "type": "string", "minLength": 1 },
    "validator": { "$ref": "#/$defs/validator" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "selectedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane", "entry_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "lane": { "enum": ["mandatory", "diagnostic", "release"] },
        "entry_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_id", "fresh", "route"],
      "properties": {
        "validator_id": { "type": "string", "minLength": 1 },
        "fresh": { "const": true },
        "route": { "const": "single_fresh" }
      }
    }
  }
}
