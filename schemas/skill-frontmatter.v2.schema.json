{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "agentops:skill-frontmatter.v2",
  "practices": ["data-contracts", "design-by-contract"],
  "type": "object",
  "required": ["name", "description", "hexagonal_role", "practices", "metadata"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "name": {"type": "string"},
    "description": {"type": "string"},
    "spine": {"type": "boolean", "description": "True iff this skill is one of the 15 canonical membrane+bookkeeper spine skills. Durability anchor — see scripts/check-spine-integrity.sh (age-focus-membrane-bookkeeper-m1wg.23)."},
    "practices": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "REQUIRED: at least one practice citation (e.g. 'data-contracts', 'design-by-contract'). Every skill must declare which engineering practices it embodies."
    },
    "hexagonal_role": {
      "type": "string",
      "enum": ["domain", "driving-adapter", "driven-adapter", "supporting", "generic"],
      "description": "REQUIRED: which hexagonal-architecture role this skill plays. Enforces the DDD/hex layer cannot drift silently (registries-drift lesson, 2026-05-17)."
    },
    "trigger_probes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "OPTIONAL: deterministic lexical trigger phrases this skill must rank #1 for under scan_descriptions.py --probe. Each phrase is a self-declared selection cue; the probe asserts the skill wins its own phrases against the corpus without a live model."
    },
    "consumes": {
      "type": "array",
      "items": {"type": "string", "description": "artifact-kind or skill slug"}
    },
    "produces": {
      "type": "array",
      "items": {"type": "string"}
    },
    "context_rel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "with"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["shared-kernel", "customer-of", "supplier-to", "conformist-to", "acl-wraps", "separate-ways", "partnership"]
          },
          "with": {"type": "string", "description": "skill slug"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["tier", "dependencies", "capabilities", "effects", "canonical_status", "disposition"],
      "properties": {
        "tier": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_status": {"enum": ["canonical"]},
        "disposition": {"enum": ["keep", "keep_off_path", "keep_strategy", "keep_optional_adapter", "keep_specialist"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
