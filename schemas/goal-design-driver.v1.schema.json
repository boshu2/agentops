{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/goal-design-driver.v1.schema.json",
  "title": "AgentOps Goal Design Driver v1",
  "description": "YAML frontmatter contract for .agents/goal-design/<slug>/driver.md, the loop-driving map from an intent artifact into candidate bead work.",
  "practices": ["bdd-gherkin", "design-by-contract", "tdd"],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "slug",
    "created_at",
    "status",
    "intent_ref",
    "loop_routing",
    "candidate_beads",
    "small_batch_gate",
    "route_back_rules",
    "execution_mode",
    "artifact_validation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "goal-design.driver"
    },
    "id": {
      "type": "string",
      "pattern": "^gd-driver-[a-z0-9][a-z0-9-]*$"
    },
    "slug": {
      "$ref": "#/$defs/slug"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "validated", "superseded"]
    },
    "intent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "loop_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery", "rpi", "promotion", "knowledge"],
      "properties": {
        "delivery": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rpi": {
          "$ref": "#/$defs/non_empty_string"
        },
        "promotion": {
          "$ref": "#/$defs/non_empty_string"
        },
        "knowledge": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "candidate_beads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behavior",
          "bounded_context",
          "first_failing_proof",
          "write_scope",
          "close_signal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B[0-9]+$"
          },
          "behavior": {
            "$ref": "#/$defs/non_empty_string"
          },
          "bounded_context": {
            "$ref": "#/$defs/non_empty_string"
          },
          "first_failing_proof": {
            "$ref": "#/$defs/non_empty_string"
          },
          "write_scope": {
            "$ref": "#/$defs/non_empty_string_list"
          },
          "close_signal": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "small_batch_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_behavior",
        "one_bounded_context",
        "one_primary_write_scope",
        "one_acceptance_proof",
        "split_required_if"
      ],
      "properties": {
        "one_behavior": {
          "type": "boolean",
          "const": true
        },
        "one_bounded_context": {
          "type": "boolean",
          "const": true
        },
        "one_primary_write_scope": {
          "type": "boolean",
          "const": true
        },
        "one_acceptance_proof": {
          "type": "boolean",
          "const": true
        },
        "split_required_if": {
          "$ref": "#/$defs/non_empty_string_list"
        }
      }
    },
    "route_back_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_fails",
        "bead_closes_with_new_signal",
        "candidate_stale",
        "promotion_contradicts_intent"
      ],
      "properties": {
        "validation_fails": {
          "$ref": "#/$defs/non_empty_string"
        },
        "bead_closes_with_new_signal": {
          "$ref": "#/$defs/non_empty_string"
        },
        "candidate_stale": {
          "$ref": "#/$defs/non_empty_string"
        },
        "promotion_contradicts_intent": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "execution_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "escalations"],
      "properties": {
        "default": {
          "type": "string",
          "enum": ["single-agent"]
        },
        "escalations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ntm_atm", "workflow"],
          "properties": {
            "ntm_atm": {
              "$ref": "#/$defs/non_empty_string"
            },
            "workflow": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        }
      }
    },
    "artifact_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_command", "independent_validator", "required_verdict"],
      "properties": {
        "checker_command": {
          "$ref": "#/$defs/non_empty_string"
        },
        "independent_validator": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_verdict": {
          "type": "string",
          "enum": ["PASS"]
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "non_empty_string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  }
}
