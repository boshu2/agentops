{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/ao-state-finding-candidate.v1.schema.json",
  "title": "AgentOps AO State Finding Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "source",
    "severity",
    "category",
    "summary",
    "evidence",
    "body"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ao_state_finding_candidate" },
    "id": {
      "type": "string",
      "pattern": "^finding-[a-z0-9][a-z0-9._-]*$",
      "minLength": 10,
      "maxLength": 120
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "enum": ["candidate"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bead_id",
        "run_id",
        "author_id",
        "author_context_id",
        "author_family",
        "repo",
        "path",
        "source_digest"
      ],
      "properties": {
        "bead_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9](?:-[a-z0-9]+)*(?:\\.[0-9a-z]+)*$",
          "minLength": 3,
          "maxLength": 160
        },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "author_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "author_context_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "author_family": { "type": "string", "minLength": 1, "maxLength": 80 },
        "repo": { "type": "string", "minLength": 1, "maxLength": 120 },
        "path": {
          "type": "string",
          "pattern": "^(\\.agents/findings|docs|cli|schemas)/[^\\n]+$",
          "not": { "pattern": "(^|/)\\.\\.(/|$)" },
          "maxLength": 300
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["minor", "significant", "major", "critical"]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "body": { "type": "string", "minLength": 1, "maxLength": 5000 }
  }
}
