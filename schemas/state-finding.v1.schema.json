{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/state-finding.v1.schema.json",
  "title": "AgentOps State Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "status",
    "created_at",
    "updated_at",
    "source",
    "review",
    "severity",
    "category",
    "summary",
    "evidence",
    "body"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "state_finding" },
    "id": {
      "type": "string",
      "pattern": "^finding-[a-z0-9][a-z0-9._-]*$",
      "minLength": 10,
      "maxLength": 120
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "type": "string", "enum": ["active", "superseded", "retired"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bead_id", "run_id", "author_id", "repo", "path"],
      "properties": {
        "bead_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9](?:-[a-z0-9]+)*(?:\\.[0-9a-z]+)*$",
          "minLength": 3,
          "maxLength": 160
        },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "author_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "repo": { "type": "string", "minLength": 1, "maxLength": 120 },
        "path": {
          "type": "string",
          "pattern": "^(\\.agents/findings|\\.agents/state/findings|docs|cli|schemas)/[^\\n]+$",
          "not": { "pattern": "(^|/)\\.\\.(/|$)" },
          "maxLength": 300
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "verdict", "head_sha"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED", "WARN"] },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["minor", "significant", "major", "critical"]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "body": { "type": "string", "minLength": 1, "maxLength": 5000 }
  }
}
