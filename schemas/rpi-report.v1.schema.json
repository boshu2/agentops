{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/rpi-report.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "intent_ref", "acceptance_digest", "subject_manifest_digest", "verdict_ref", "verdict_digest", "checked", "not_checked"],
  "properties": {
    "schema_version": {"const": "rpi-report.v1"},
    "status": {"enum": ["PASS", "FAIL", "NOT_PROVEN", "NOT_PLANNED", "NOT_BUILT"]},
    "intent_ref": {"type": ["string", "null"], "minLength": 1},
    "acceptance_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "subject_manifest_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "verdict_ref": {"type": ["string", "null"]},
    "verdict_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "checked": {"type": "array", "items": {"type": "string"}},
    "not_checked": {"type": "array", "items": {"type": "string"}}
  }
}
