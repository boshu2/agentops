{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/producer-rule-candidate.v1.schema.json",
  "title": "Advisory Producer Rule Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class_key", "recurrence_count", "advisory", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^producer-[0-9a-f]{12}$"},
    "class_key": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "recurrence_count": {"type": "integer", "minimum": 2},
    "advisory": {"const": true},
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "objective_id", "evidence_ref"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "objective_id": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
