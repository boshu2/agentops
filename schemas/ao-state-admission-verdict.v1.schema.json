{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/ao-state-admission-verdict.v1.schema.json",
  "title": "AgentOps AO State Admission Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "candidate_id",
    "candidate_digest",
    "reviewer_id",
    "reviewer_context_id",
    "reviewer_family",
    "reviewed_at",
    "verdict",
    "head_sha",
    "evidence_ref",
    "proof_ref",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ao_state_admission_verdict" },
    "candidate_id": {
      "type": "string",
      "pattern": "^finding-[a-z0-9][a-z0-9._-]*$",
      "minLength": 10,
      "maxLength": 120
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reviewer_context_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reviewer_family": { "type": "string", "minLength": 1, "maxLength": 80 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED", "WARN"] },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "proof_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
