{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/validation-budget-receipt.v1.schema.json",
  "title": "Validate run-budget admission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason",
    "run_id",
    "request_id",
    "request_sha256",
    "factual_receipt_availability",
    "factual_receipt_sha256",
    "action",
    "charge",
    "governor",
    "validator_dispatch_allowed",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["AUTHORIZED", "NONAUTHORIZING"] },
    "reason": { "type": "string", "minLength": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "request_id": { "type": "string", "minLength": 1 },
    "request_sha256": { "$ref": "#/$defs/digest" },
    "factual_receipt_availability": {
      "enum": ["present", "absent", "invalid_json"]
    },
    "factual_receipt_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "action": { "const": "semantic-review" },
    "charge": { "$ref": "#/$defs/requestedCharge" },
    "governor": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/governorEvidence" }
      ]
    },
    "validator_dispatch_allowed": { "type": "boolean" },
    "next_action": {
      "oneOf": [
        { "const": "VALIDATE_SINGLE_FRESH" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "AUTHORIZED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": { "const": "admitted-before-dispatch" },
          "factual_receipt_availability": { "const": "present" },
          "factual_receipt_sha256": { "$ref": "#/$defs/digest" },
          "charge": { "$ref": "#/$defs/completeCharge" },
          "governor": {
            "allOf": [
              { "$ref": "#/$defs/governorEvidence" },
              {
                "properties": {
                  "admission_id": { "type": "string", "minLength": 1 },
                  "disposition": { "const": "NOTE" },
                  "reason": { "const": "admitted-before-dispatch" },
                  "authorized": { "const": true },
                  "helper_allowed": { "const": false },
                  "usage": { "$ref": "#/$defs/meters" }
                }
              }
            ]
          },
          "validator_dispatch_allowed": { "const": true },
          "next_action": { "const": "VALIDATE_SINGLE_FRESH" }
        }
      },
      "else": {
        "properties": {
          "governor": {
            "oneOf": [
              { "type": "null" },
              {
                "allOf": [
                  { "$ref": "#/$defs/governorEvidence" },
                  {
                    "properties": {
                      "admission_id": { "type": "null" },
                      "authorized": { "const": false }
                    }
                  }
                ]
              }
            ]
          },
          "validator_dispatch_allowed": { "const": false },
          "next_action": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "factual_receipt_availability": { "const": "absent" }
        },
        "required": ["factual_receipt_availability"]
      },
      "then": {
        "properties": {
          "status": { "const": "NONAUTHORIZING" },
          "factual_receipt_sha256": { "type": "null" },
          "governor": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "factual_receipt_sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "factual_receipt_availability": { "const": "invalid_json" }
        },
        "required": ["factual_receipt_availability"]
      },
      "then": {
        "properties": {
          "status": { "const": "NONAUTHORIZING" },
          "factual_receipt_sha256": { "$ref": "#/$defs/digest" },
          "governor": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "pattern": "^hard-ceiling:" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "status": { "const": "NONAUTHORIZING" },
          "governor": {
            "allOf": [
              { "$ref": "#/$defs/governorEvidence" },
              {
                "properties": {
                  "admission_id": { "type": "null" },
                  "disposition": { "const": "ANDON" },
                  "authorized": { "const": false },
                  "helper_allowed": { "const": false }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "governor": { "type": "null" } },
        "required": ["governor"]
      },
      "then": {
        "properties": { "status": { "const": "NONAUTHORIZING" } }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableCounter": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "requestedCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_tokens",
        "elapsed_seconds",
        "review_contexts",
        "deterministic_executions"
      ],
      "properties": {
        "reviewer_tokens": { "$ref": "#/$defs/nullableCounter" },
        "elapsed_seconds": { "$ref": "#/$defs/nullableCounter" },
        "review_contexts": { "$ref": "#/$defs/nullableCounter" },
        "deterministic_executions": { "$ref": "#/$defs/nullableCounter" }
      }
    },
    "completeCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_tokens",
        "elapsed_seconds",
        "review_contexts",
        "deterministic_executions"
      ],
      "properties": {
        "reviewer_tokens": { "type": "integer", "minimum": 0 },
        "elapsed_seconds": { "type": "integer", "minimum": 0 },
        "review_contexts": { "type": "integer", "minimum": 0 },
        "deterministic_executions": { "type": "integer", "minimum": 0 }
      }
    },
    "meters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waves",
        "reviewer_tokens",
        "elapsed_seconds",
        "review_contexts",
        "deterministic_executions"
      ],
      "properties": {
        "waves": { "type": "integer", "minimum": 0 },
        "reviewer_tokens": { "type": "integer", "minimum": 0 },
        "elapsed_seconds": { "type": "integer", "minimum": 0 },
        "review_contexts": { "type": "integer", "minimum": 0 },
        "deterministic_executions": { "type": "integer", "minimum": 0 }
      }
    },
    "governorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_id",
        "disposition",
        "reason",
        "authorized",
        "helper_allowed",
        "usage",
        "receipt_sha256"
      ],
      "properties": {
        "admission_id": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "disposition": {
          "enum": ["NOTE", "REPAIR", "REPLAN", "HOLD", "ANDON"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "authorized": { "type": "boolean" },
        "helper_allowed": { "type": "boolean" },
        "usage": {
          "oneOf": [
            { "$ref": "#/$defs/meters" },
            { "type": "null" }
          ]
        },
        "receipt_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
