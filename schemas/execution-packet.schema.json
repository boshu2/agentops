{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/execution-packet.schema.json",
  "title": "RPI Execution Packet",
  "description": "Per-run execution packet emitted by ao rpi; captures objective, validation surface, and (v2+) per-criterion acceptance criteria for the epic and its beads.",
  "practices": ["design-by-contract", "pragmatic-programmer"],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"enum": [1, 2]}},
        "required": ["schema_version"]
      },
      "then": {
        "dependentRequired": {"premortem_verdict": ["pre_mortem_verdict"]},
        "properties": {
          "artifacts": {
            "dependentRequired": {"premortem_path": ["pre_mortem_path"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 3}},
        "required": ["schema_version"]
      },
      "then": {
        "dependentRequired": {"pre_mortem_verdict": ["premortem_verdict"]},
        "properties": {
          "artifacts": {
            "dependentRequired": {"pre_mortem_path": ["premortem_path"]}
          }
        }
      }
    },
    {
      "if": {
        "required": ["pre_mortem_verdict", "premortem_verdict"]
      },
      "then": {
        "oneOf": [
          {"properties": {"pre_mortem_verdict": {"const": "PASS"}, "premortem_verdict": {"const": "PASS"}}},
          {"properties": {"pre_mortem_verdict": {"const": "WARN"}, "premortem_verdict": {"const": "WARN"}}},
          {"properties": {"pre_mortem_verdict": {"const": "FAIL"}, "premortem_verdict": {"const": "FAIL"}}}
        ]
      }
    },
    {
      "not": {
        "required": ["artifacts"],
        "properties": {
          "artifacts": {
            "required": ["pre_mortem_path", "premortem_path"]
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2, 3]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "skills_loaded": {
      "type": "array",
      "items": {"$ref": "#/$defs/SkillLoad"}
    },
    "phase_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/PhaseReceipt"}
    },
    "run_id": {
      "type": "string"
    },
    "epic_id": {
      "type": ["string", "null"]
    },
    "bead_id": {
      "type": "string"
    },
    "tracking_repo_root": {
      "type": "string"
    },
    "beads_dir": {
      "type": "string"
    },
    "pr_url": {
      "type": "string"
    },
    "merge_commit": {
      "type": "string"
    },
    "plan_path": {
      "type": "string"
    },
    "density": {
      "$ref": "#/$defs/Density"
    },
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    },
    "contract_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_lanes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationLane"
      }
    },
    "tracker_mode": {
      "type": "string"
    },
    "tracker_health": {
      "type": "object"
    },
    "done_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy v1 stop-conditions list. Preserved for back-compat; v2+ packets prefer epic_criteria/bead_criteria."
    },
    "epic_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "description": "Acceptance criteria attached to the epic."
    },
    "bead_criteria": {
      "type": "object",
      "description": "Acceptance criteria keyed by bead ID.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Criterion"
        }
      }
    },
    "routing": {
      "type": "object",
      "description": "Typed implementer/reviewer routing keyed by bead ID.",
      "additionalProperties": {
        "$ref": "#/$defs/Routing"
      }
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    },
    "complexity": {
      "type": "string",
      "enum": ["fast", "standard", "full"]
    },
    "pre_mortem_verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "premortem_verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "default_verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"],
      "default": "FAIL",
      "description": "Fail-closed verdict applied when a criterion or reviewer has not produced an explicit verdict."
    },
    "test_levels": {
      "$ref": "#/$defs/TestLevels"
    },
    "ranked_packet_path": {
      "type": "string"
    },
    "discovery_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "proof_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluator_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "proof_updated_at": {
      "type": "string"
    },
    "autodev_program": {
      "$ref": "#/$defs/AutodevProgram"
    },
    "mixed_mode_requested": {
      "type": "boolean"
    },
    "mixed_mode_effective": {
      "type": "boolean"
    },
    "planner_vendor": {
      "type": "string"
    },
    "reviewer_vendor": {
      "type": "string"
    },
    "mixed_mode_degraded_reason": {
      "type": "string"
    },
    "orchestration_decision": {
      "type": "object",
      "description": "The recorded orchestration-shape decision (the ATM/AM call): the chosen shape plus the deterministic predicates that fired to reach it. Additive and advisory — it captures the decision and claims nothing about its quality. Defaults to single-agent (operating-loop principle 8); escalation predicates that override the default land in a later slice.",
      "additionalProperties": false,
      "required": ["chosen_shape"],
      "properties": {
        "chosen_shape": {
          "type": "string",
          "enum": ["single-agent", "am-only", "atm-only", "both"]
        },
        "predicates_fired": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" },
        "ts": { "type": "string" }
      }
    },
    "phase": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "discovery_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "$ref": "#/$defs/DiscoveryArtifactScope"
    },
    "abort_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tdd_matrix": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "issues": {
      "type": "array",
      "description": "Slim-packet bead list (id/title/wave/blocked_by) emitted by ao rpi alongside epic_criteria/bead_criteria.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "wave": { "type": "integer" },
          "blocked_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "done_when": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Slim-packet stop-conditions list (the emitted alias of done_criteria)."
    },
    "likely_blocker": {
      "type": "string",
      "description": "Slim-packet free-text note on the most probable blocker."
    },
    "ignore_today": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Slim-packet explicit out-of-scope-for-now list."
    }
  },
  "$defs": {
    "SkillLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reason"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "PhaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "skill", "status", "artifact"],
      "properties": {
        "phase": {"type": "string", "enum": ["discovery", "crank", "validate", "learn"]},
        "skill": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["DONE", "PARTIAL", "BLOCKED", "PASS", "WARN", "FAIL", "REFUTED"]},
        "artifact": {"type": "string", "minLength": 1},
        "next_action": {"type": "string"}
      }
    },
    "AutodevProgram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "mutable_scope": { "type": "array", "items": { "type": "string" } },
        "immutable_scope": { "type": "array", "items": { "type": "string" } },
        "experiment_unit": { "type": "string" },
        "validation_commands": { "type": "array", "items": { "type": "string" } },
        "decision_policy": { "type": "array", "items": { "type": "string" } },
        "stop_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ValidationLane": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structural shape of a validation lane carried through the packet. The repo-execution-profile schema (docs/contracts/repo-execution-profile.schema.json) is the authority for lane POLICY validity (cost_class/auto_select enums, required policy fields) and validates lanes at the profile boundary; this packet schema enforces lane STRUCTURE (closed field set, types, null-able escape hatch). Defense-in-depth replication of the profile policy enums here is tracked as a follow-up.",
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string" },
        "purpose": { "type": "string" },
        "read_only": { "type": "boolean" },
        "writes_artifacts": { "type": "boolean" },
        "artifact_paths": { "type": "array", "items": { "type": "string" } },
        "isolated_agents_home": { "type": "boolean" },
        "release_only": { "type": "boolean" },
        "mutation_escape_hatch": { "type": ["string", "null"] },
        "cost_class": { "type": "string" },
        "auto_select": { "type": "string" },
        "timeout_seconds": { "type": "integer" },
        "expensive_reason": { "type": "string" }
      }
    },
    "Density": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "boundary",
        "evidence",
        "decision",
        "constraint",
        "next_action"
      ],
      "properties": {
        "intent": {
          "type": "string"
        },
        "boundary": {
          "$ref": "#/$defs/Boundary"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string"
        },
        "constraint": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "Boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_context",
        "non_goals"
      ],
      "anyOf": [
        { "required": ["write_scope"], "properties": { "write_scope": { "minItems": 1 } } },
        { "required": ["write_scope_first_slice"], "properties": { "write_scope_first_slice": { "minItems": 1 } } }
      ],
      "properties": {
        "bounded_context": {
          "type": "string"
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Generic write-scope list. The current ao rpi emitter writes write_scope_first_slice instead; at least one should be present."
        },
        "write_scope_first_slice": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Write scope for the first slice — the field the current ao rpi slim emitter produces."
        }
      }
    },
    "Artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research_path": {
          "type": "string"
        },
        "plan_path": {
          "type": "string"
        },
        "pre_mortem_path": {
          "type": "string"
        },
        "premortem_path": {
          "type": "string"
        },
        "ranked_packet_path": {
          "type": ["string", "null"]
        },
        "perspective_plan_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "synthesis_packet_path": {
          "type": ["string", "null"]
        },
        "fable_approval_path": {
          "type": ["string", "null"]
        },
        "approval_edge_path": {
          "type": ["string", "null"]
        }
      }
    },
    "TestLevels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "recommended",
        "rationale"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestLevel"
          }
        },
        "recommended": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestLevel"
          }
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "TestLevel": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3"]
    },
    "ModelFamily": {
      "type": "string",
      "enum": ["claude", "codex", "gemini"]
    },
    "Routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementer",
        "reviewer",
        "rationale"
      ],
      "properties": {
        "implementer": {
          "$ref": "#/$defs/ModelFamily"
        },
        "reviewer": {
          "$ref": "#/$defs/ModelFamily"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_path",
        "red_test"
      ],
      "properties": {
        "test_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the behavior-first test file that encodes the contract."
        },
        "red_test": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the pre-written failing test that proves the contract before implementation."
        }
      }
    },
    "DiscoveryArtifactScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loc_estimate": {
          "type": "integer"
        }
      }
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "check_type",
        "evidence_required",
        "weight",
        "optional"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ac-[a-z0-9][a-z0-9._-]*\\.[0-9]+$",
          "description": "Stable criterion identifier of the form ac-<scope>.<n>."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One-line measurable acceptance statement."
        },
        "check_type": {
          "type": "string",
          "enum": [
            "test_pass",
            "command_exit_zero",
            "file_exists",
            "grep_match",
            "manual",
            "council_judge",
            "custom_rubric"
          ]
        },
        "check_command": {
          "type": "string"
        },
        "evidence_path": {
          "type": "string"
        },
        "evidence_required": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "optional": {
          "type": "boolean"
        },
        "agent_judge": {
          "type": "string",
          "description": "Names the council or judge that owns the verdict. Required when check_type == \"custom_rubric\"."
        }
      },
      "if": {
        "properties": {
          "check_type": {
            "const": "custom_rubric"
          }
        },
        "required": ["check_type"]
      },
      "then": {
        "required": ["agent_judge"],
        "properties": {
          "agent_judge": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
