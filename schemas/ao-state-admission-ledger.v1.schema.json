{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/ao-state-admission-ledger.v1.schema.json",
  "title": "AgentOps AO State Admission Ledger Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "finding_id",
    "candidate_digest",
    "verdict_digest",
    "accepted_path",
    "admitted_at",
    "admitted_by",
    "reviewer_id",
    "reviewer_context_id",
    "reviewer_family",
    "evidence_ref",
    "proof_ref",
    "trust_tier",
    "execution_context"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ao_state_admission_ledger_row" },
    "finding_id": {
      "type": "string",
      "pattern": "^finding-[a-z0-9][a-z0-9._-]*$",
      "minLength": 10,
      "maxLength": 120
    },
    "candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdict_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "accepted_path": {
      "type": "string",
      "pattern": "^\\.ao/accepted/findings/[A-Za-z0-9._-]+\\.json$",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" },
      "maxLength": 300
    },
    "admitted_at": { "type": "string", "format": "date-time" },
    "admitted_by": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reviewer_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reviewer_context_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reviewer_family": { "type": "string", "minLength": 1, "maxLength": 80 },
    "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "proof_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "trust_tier": { "type": "string", "enum": ["fresh-context", "multi-model", "deterministic"] },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bead_id",
        "worktree_path",
        "branch",
        "head_sha",
        "canonical_bead_state_source",
        "pane_mode"
      ],
      "properties": {
        "bead_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9](?:-[a-z0-9]+)*(?:\\.[0-9a-z]+)*$",
          "minLength": 3,
          "maxLength": 160
        },
        "worktree_path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "head_sha": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reservation_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "canonical_bead_state_source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "pane_mode": { "type": "string", "enum": ["single-pane", "multi-pane"] },
        "single_pane_downgrade_reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "pane_mode": { "const": "single-pane" } }, "required": ["pane_mode"] },
          "then": { "required": ["single_pane_downgrade_reason"] }
        },
        {
          "if": { "properties": { "pane_mode": { "const": "multi-pane" } }, "required": ["pane_mode"] },
          "then": { "required": ["reservation_id"] }
        }
      ]
    }
  }
}
