{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.local/schemas/premortem-plan-review.v1.schema.json",
  "title": "Premortem Plan Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_digest",
    "author_context_id",
    "judge_context_id",
    "authorization_id",
    "judge_adapter",
    "judge_model_identity",
    "judge_status",
    "judge_output_bytes",
    "judge_process_group_reaped",
    "disposable_state_clean",
    "input_packet",
    "limits",
    "findings",
    "checked",
    "not_checked"
  ],
  "properties": {
    "schema_version": {"const": "premortem-plan-review.v1"},
    "intent_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "author_context_id": {"type": "string", "minLength": 1},
    "judge_context_id": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "judge_adapter": {"type": "string", "minLength": 1, "maxLength": 128},
    "judge_model_identity": {"type": "string", "minLength": 1, "maxLength": 128},
    "judge_status": {"enum": ["completed", "timed_out", "error"]},
    "judge_output_bytes": {"type": "integer", "minimum": 0, "maximum": 32768},
    "judge_process_group_reaped": {"const": true},
    "disposable_state_clean": {"const": true},
    "input_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "byte_length", "sha256"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 262144},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judge_timeout_seconds", "overall_timeout_seconds", "max_judge_output_bytes"],
      "properties": {
        "judge_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "overall_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_judge_output_bytes": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        }
      }
    },
    "checked": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "not_checked": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
  },
  "allOf": [
    {
      "if": {"properties": {"judge_status": {"const": "completed"}}},
      "then": {
        "properties": {
          "judge_output_bytes": {"minimum": 1},
          "checked": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "findings": {"maxItems": 0},
          "checked": {"maxItems": 0},
          "not_checked": {"minItems": 1}
        }
      }
    }
  ]
}
