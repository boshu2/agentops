{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentops.local/skills/skill-builder/schemas/compile-report.json",
  "title": "Shadow skill contract compile receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "source",
    "contract",
    "compiler",
    "proof",
    "checks",
    "result",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-contract-compile-receipt.v1"
    },
    "skill": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "before_sha256",
        "after_sha256",
        "unchanged"
      ],
      "properties": {
        "ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "before_sha256": {
          "$ref": "#/definitions/nullable_sha256"
        },
        "after_sha256": {
          "$ref": "#/definitions/nullable_sha256"
        },
        "unchanged": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_sha256",
        "digest"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/skill-contract.v3.schema.json"
        },
        "schema_sha256": {
          "$ref": "#/definitions/nullable_sha256"
        },
        "digest": {
          "$ref": "#/definitions/nullable_sha256"
        }
      }
    },
    "compiler": {
      "$ref": "#/definitions/compiler_identity"
    },
    "proof": {
      "oneOf": [
        {
          "$ref": "#/definitions/proof_identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema",
          "authority",
          "effects",
          "artifacts",
          "triggers",
          "failure",
          "proof",
          "hard_dependencies",
          "source_unchanged"
        ]
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/error"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "before_sha256": {
                "$ref": "#/definitions/sha256"
              },
              "after_sha256": {
                "$ref": "#/definitions/sha256"
              },
              "unchanged": {
                "const": true
              }
            }
          },
          "contract": {
            "properties": {
              "schema_sha256": {
                "$ref": "#/definitions/sha256"
              },
              "digest": {
                "$ref": "#/definitions/sha256"
              }
            }
          },
          "proof": {
            "$ref": "#/definitions/proof_identity"
          },
          "checks": {
            "minItems": 9,
            "maxItems": 9
          },
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/definitions/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "identity_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "digest"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identity"
          }
        },
        "digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "compiler_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "digest"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identity"
          }
        },
        "digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "proof_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "entrypoint",
        "harnesses",
        "fixtures"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "$ref": "#/definitions/identity"
        },
        "harnesses": {
          "$ref": "#/definitions/identity_set"
        },
        "fixtures": {
          "$ref": "#/definitions/identity_set"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
