{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentops.local/skills/skill-builder/schemas/probe-report.json",
  "title": "Isolated shadow skill contract probe receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "source",
    "contract",
    "compiler",
    "runner",
    "proof",
    "isolation",
    "execution",
    "result",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-contract-probe-receipt.v1"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "before_sha256",
        "after_sha256",
        "unchanged"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "before_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "after_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "unchanged": {
          "type": "boolean"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema_sha256",
        "digest"
      ],
      "properties": {
        "schema_ref": {
          "const": "schemas/skill-contract.v3.schema.json"
        },
        "schema_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "compiler": {
      "$ref": "#/definitions/identity_set"
    },
    "runner": {
      "$ref": "#/definitions/item_identity_set"
    },
    "proof": {
      "$ref": "#/definitions/proof_identity"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "initial_manifest_sha256",
        "final_manifest_sha256",
        "changed_paths",
        "out_of_scope_paths",
        "live_root_unchanged",
        "live_root_changed_paths"
      ],
      "properties": {
        "kind": {
          "const": "disposable_repository_copy"
        },
        "initial_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "final_manifest_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "changed_paths": {
          "$ref": "#/definitions/path_array"
        },
        "out_of_scope_paths": {
          "$ref": "#/definitions/path_array"
        },
        "live_root_unchanged": {
          "type": "boolean"
        },
        "live_root_changed_paths": {
          "$ref": "#/definitions/path_array"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "timed_out",
        "interrupted",
        "timeout_seconds",
        "stdout",
      "stderr",
      "cleanup",
      "confinement"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "timed_out": {
          "type": "boolean"
        },
        "interrupted": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stdout": {
          "$ref": "#/definitions/stream"
        },
        "stderr": {
          "$ref": "#/definitions/stream"
        },
      "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger",
            "term_sent",
            "kill_sent",
            "parent_reaped",
            "process_group_empty",
            "complete"
          ],
          "properties": {
            "trigger": {
              "enum": [
                "none",
                "timeout",
                "interrupted",
                "descendants"
              ]
            },
            "term_sent": {
              "type": "boolean"
            },
            "kill_sent": {
              "type": "boolean"
            },
            "parent_reaped": {
              "type": "boolean"
            },
            "process_group_empty": {
              "type": "boolean"
            },
            "complete": {
              "type": "boolean"
            }
          }
        },
        "confinement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "proven", "command_executed"],
          "properties": {
            "backend": {"enum": ["sandbox-exec", "unavailable"]},
            "proven": {"type": "boolean"},
            "command_executed": {"type": "boolean"}
          }
        }
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_PROVEN"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/error"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "unchanged": {
                "const": true
              }
            }
          },
          "isolation": {
            "properties": {
              "changed_paths": {
                "maxItems": 0
              },
              "out_of_scope_paths": {
                "maxItems": 0
              },
              "live_root_unchanged": {
                "const": true
              },
              "live_root_changed_paths": {
                "maxItems": 0
              }
            }
          },
          "execution": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "timed_out": {
                "const": false
              },
              "interrupted": {
                "const": false
              },
              "cleanup": {
                "properties": {
                  "trigger": {
                    "const": "none"
                  },
                  "parent_reaped": {
                    "const": true
                  },
                  "process_group_empty": {
                    "const": true
                  },
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          },
          "errors": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "identity_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "digest"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identity"
          }
        },
        "digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "item_identity_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "digest"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identity"
          }
        },
        "digest": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "proof_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "entrypoint",
        "harnesses",
        "fixtures"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "$ref": "#/definitions/identity"
        },
        "harnesses": {
          "$ref": "#/definitions/item_identity_set"
        },
        "fixtures": {
          "$ref": "#/definitions/item_identity_set"
        }
      }
    },
    "path_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_bytes",
        "retained_bytes",
        "sha256",
        "retained_sha256",
        "truncated"
      ],
      "properties": {
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "retained_sha256": {
          "$ref": "#/definitions/sha256"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
