{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops.dev/schemas/go-cli-family-case.v1.json",
  "type": "object",
  "required": ["schema_version", "family", "checks", "dimensions"],
  "properties": {
    "schema_version": {"const": 1},
    "family": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "object",
      "required": ["path", "aliases", "accepted_args", "rejected_args", "stdout", "stderr", "exit_classes", "tracker_selection", "ordered_effects"],
      "additionalProperties": {"$ref": "#/$defs/dimension"}
    }
  },
  "$defs": {
    "dimension": {
      "oneOf": [
        {"type": "object", "required": ["status", "evidence"], "properties": {"status": {"const": "evidence"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
        {"type": "object", "required": ["status", "reason"], "properties": {"status": {"const": "not_applicable"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
