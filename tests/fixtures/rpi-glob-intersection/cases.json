{
  "schema": "rpi-glob-intersection-cases.v1",
  "description": "Unit cases for the segment-wise glob intersection in workflows/rpi.js. `pairs` exercise globsIntersect(a, b) directly; `scopes` assert the risky classification a declared write scope receives. Two rounds of heuristics (witness matching, wildcard instantiation, literal-prefix reach) each missed a different half of the problem, so the classifier is a real intersection and these cases pin it.",
  "pairs": [
    {
      "a": "skills/rpi/**",
      "b": "skills/*/scripts/**",
      "intersect": true,
      "why": "rpi is one segment, and ** absorbs scripts/..."
    },
    {
      "a": "skills/*/SKILL.md",
      "b": "skills/*/scripts/**",
      "intersect": false,
      "why": "SKILL.md and scripts are distinct literals in the same position"
    },
    {
      "a": "cli/**",
      "b": "cli/internal/gates/**",
      "intersect": true,
      "why": "** absorbs internal/gates"
    },
    {
      "a": "cli/cmd/**",
      "b": "cli/internal/gates/**",
      "intersect": false,
      "why": "cmd and internal differ"
    },
    {
      "a": "**",
      "b": "tests/**",
      "intersect": true,
      "why": "a bare ** absorbs everything"
    },
    {
      "a": "*",
      "b": "tests/**",
      "intersect": true,
      "why": "* matches tests, and ** absorbs zero segments"
    },
    {
      "a": "scripts/check-doc-claims-tracked.sh",
      "b": "scripts/check-*.sh",
      "intersect": true,
      "why": "an interior * matches a literal segment by regex"
    },
    {
      "a": "scripts/lib/preamble.sh",
      "b": "scripts/check-*.sh",
      "intersect": false,
      "why": "lib does not match check-*.sh"
    },
    {
      "a": "scripts/*.sh",
      "b": "scripts/check-*.sh",
      "intersect": true,
      "why": "two patterned segments overlap"
    },
    {
      "a": "lib/preamble.sh",
      "b": "lib/**",
      "intersect": true,
      "why": "** absorbs the trailing segment"
    },
    {
      "a": "scripts/lib/preamble.sh",
      "b": "lib/**",
      "intersect": false,
      "why": "lib/** is anchored at the root"
    },
    {
      "a": "tests/**",
      "b": "tests/**",
      "intersect": true,
      "why": "identical patterns"
    },
    {
      "a": "docs/**",
      "b": "tests/**",
      "intersect": false,
      "why": "disjoint roots"
    },
    {
      "a": "a/**/z",
      "b": "a/b/c/z",
      "intersect": true,
      "why": "** absorbs a run of segments in the middle"
    },
    {
      "a": "a/**/z",
      "b": "a/b/c/y",
      "intersect": false,
      "why": "the anchored tail differs"
    },
    {
      "a": "a/b",
      "b": "a/b/**",
      "intersect": true,
      "why": "a trailing ** absorbs zero segments"
    },
    {
      "a": "a/b",
      "b": "a/b/c",
      "intersect": false,
      "why": "different depths with no wildcard"
    }
  ],
  "scopes": [
    {
      "glob": "skills/rpi/**",
      "risky": true
    },
    {
      "glob": "skills/validate/**",
      "risky": true
    },
    {
      "glob": "skills/premortem/**",
      "risky": true
    },
    {
      "glob": "skills/anything-at-all/**",
      "risky": true
    },
    {
      "glob": "skills/*/SKILL.md",
      "risky": false
    },
    {
      "glob": "docs/**",
      "risky": false
    },
    {
      "glob": "workflows/rpi.js",
      "risky": false
    },
    {
      "glob": "README.md",
      "risky": false
    },
    {
      "glob": "cli/cmd/**",
      "risky": false
    },
    {
      "glob": "cli/internal/statusapp/**",
      "risky": false
    },
    {
      "glob": "scripts/lib/preamble.sh",
      "risky": false
    },
    {
      "glob": "cli/**",
      "risky": true
    },
    {
      "glob": "**",
      "risky": true
    },
    {
      "glob": "*",
      "risky": true
    },
    {
      "glob": "./tests/**",
      "risky": true
    },
    {
      "glob": "scripts/*.sh",
      "risky": true
    },
    {
      "glob": "scripts/check-doc-claims-tracked.sh",
      "risky": true
    },
    {
      "glob": "skills/rpi/scripts/**",
      "risky": true
    },
    {
      "glob": "lib/preamble.sh",
      "risky": true
    },
    {
      "glob": ".github/workflows/validate.yml",
      "risky": true
    },
    {
      "glob": "cli/internal/gates/new.go",
      "risky": true
    },
    {
      "glob": "././tests/**",
      "risky": true
    },
    {
      "glob": "tests/../cli/**",
      "risky": true
    },
    {
      "glob": "docs/./sub/../**",
      "risky": false
    }
  ],
  "rejected": {
    "description": "Scopes the traversal refuses outright rather than classifying: an absolute path is not repo-relative, a scope that climbs out of the root has no meaning inside it, a control character cannot appear in a path the runtime will act on, and glob syntax the intersection does not implement would be classified by a matcher that cannot read it.",
    "globs": [
      "/tests/**",
      "/etc/passwd",
      "../outside/**",
      "tests/../../escape/**",
      "~/notes/**",
      "tests/\nbats/**",
      "tests/\ty/**",
      "tests/\u0000z/**",
      "tests/?.bats",
      "tests/[a-z]/**",
      "tests/{a,b}/**",
      "tests/***/x"
    ]
  }
}
