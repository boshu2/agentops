      ],
      "expect": {
        "kind": "invalid",
        "message": "at least one finding"
      }
    },
    {
      "name": "class-mutation-on-a-surviving-id",
      "description": "f1[X] -> f1[Y] -> f2[X]: the id survives while its class silently changes, which retires X with no id ever resolving and lets the same kind reappear on a new id unremarked. A class is a STABLE property of a finding; mutating it on a surviving id is a malformed round, not a repair.",
      "repair_rounds": 3,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "b",
          "findings": [
            {
              "id": "f1",
              "class": "scope.coverage",
              "summary": "the seal is not pinned"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "c",
          "findings": [
            {
              "id": "f2",
              "class": "seal.pinning",
              "summary": "the seal is still not pinned"
            }
          ]
        }
      ],
      "expect": {
        "kind": "invalid",
        "message": "class"
      }
    },
    {
      "name": "class-removed-from-a-surviving-id",
      "description": "A surviving id that drops its class is the same mutation wearing the other sign: the law would read the kind as retired while the defect is still open under the same id.",
      "repair_rounds": 3,
      "rounds": [
        {
