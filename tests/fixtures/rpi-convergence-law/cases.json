        {
          "verdict": "FAIL",
          "digest": "c",
          "findings": [
            {
              "id": "f3",
              "class": "evidence.binding",
              "summary": "the evidence names no subject digest"
            }
          ]
        }
      ],
      "expect": {
        "kind": "stop",
        "stop_reason": "repair_budget_exhausted",
        "stop_reasons": [
          "repair_budget_exhausted"
        ],
        "status": "FAIL",
        "rounds_used": 2
      }
    },
    {
      "name": "blank-class",
      "description": "A present-but-blank class is a malformed round key, not an absent one: reading it as 'no kind' silently disarms the class law.",
      "repair_rounds": 2,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "   ",
              "summary": "the seal is not pinned"
            }
          ]
        }
      ],
      "expect": {
        "kind": "invalid",
        "message": "class"
      }
    },
    {
      "name": "duplicate-ids",
      "description": "One leg naming the same id twice must be rejected, never folded last-write-wins: the id is the law's identity, and a silent fold makes 'the set did not grow' meaningless.",
      "repair_rounds": 2,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
