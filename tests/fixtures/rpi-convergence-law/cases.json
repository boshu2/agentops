            {
              "id": "f1",
              "class": "scope.coverage",
              "summary": "a different defect wearing the same id"
            }
          ]
        }
      ],
      "expect": {
        "kind": "invalid",
        "message": "twice"
      }
    },
    {
      "name": "fail-without-findings",
      "description": "A FAIL that names nothing to repair is a verdict without a subject: the repair stage would have nothing to fix and the law nothing to measure.",
      "repair_rounds": 2,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": []
