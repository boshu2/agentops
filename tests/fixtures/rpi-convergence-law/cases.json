{
  "schema": "rpi-convergence-law-cases.v1",
  "description": "Adversarial convergence-law rounds, read by BOTH implementations of the law: the Python reference behavior (skills/rpi/tests/test_run_once.py) and the workflow (tests/scripts/agentops-product-boundary.bats drives workflows/rpi.js). A case that only one side reads proves nothing about parity, which is exactly how the continuous-rename hole survived: the class conditions were tested in Python only. `digest` is a single character each suite expands to a 64-character hex digest; `class` is omitted when the finding carries none. A round may carry `legs` instead of `findings`: two validate results judged the same subject, which is how a cross-leg identity collision reaches the law.",
  "cases": [
    {
      "name": "continuous-rename",
      "description": "f1[X] -> f2[X] -> f3[X]: the open set never grows, no id reopens, and every round names a fresh id for the SAME kind. A newly minted id is not a survivor, so the class it carries reopens the moment its only prior carrier resolves.",
      "repair_rounds": 3,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "b",
          "findings": [
            {
              "id": "f2",
              "class": "seal.pinning",
              "summary": "the seal is pinned at the wrong layer"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "c",
          "findings": [
            {
              "id": "f3",
              "class": "seal.pinning",
              "summary": "the seal pin is not enforced"
            }
          ]
        }
      ],
      "expect": {
        "kind": "stop",
        "stop_reason": "class_reopened",
        "stop_reasons": [
          "class_reopened"
        ],
        "status": "NOT_PROVEN",
        "rounds_used": 1
      }
    },
    {
      "name": "classless-middle-round",
      "description": "f1[X] -> f2[no class] -> f3[X]: the rename hides behind one classless round. The class retired in round 1 must still be remembered in round 2.",
      "repair_rounds": 3,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "b",
          "findings": [
            {
              "id": "f2",
              "summary": "an unrelated defect with no nameable kind"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "c",
          "findings": [
            {
              "id": "f3",
              "class": "seal.pinning",
              "summary": "the seal pin is not enforced"
            }
          ]
        }
      ],
      "expect": {
        "kind": "stop",
        "stop_reason": "class_reopened",
        "stop_reasons": [
          "class_reopened"
        ],
        "status": "NOT_PROVEN",
        "rounds_used": 2
      }
    },
    {
      "name": "simultaneous-id-and-class-reopen",
      "description": "The round reopens a closed id AND that id's closed class. The id is the more specific diagnosis and leads, but the class disposition is reported independently rather than swallowed by the precedence.",
      "repair_rounds": 3,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
            },
            {
              "id": "f2",
              "class": "scope.coverage",
              "summary": "a changed path is uncovered"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "b",
          "findings": [
            {
              "id": "f2",
              "class": "scope.coverage",
              "summary": "a changed path is uncovered"
            }
          ]
        },
        {
          "verdict": "FAIL",
          "digest": "c",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
            }
          ]
        }
      ],
      "expect": {
        "kind": "stop",
        "stop_reason": "reopened_finding",
        "stop_reasons": [
          "reopened_finding",
          "class_reopened"
        ],
        "status": "NOT_PROVEN",
        "rounds_used": 2
      }
    },
    {
      "name": "distinct-classes-run-on",
      "description": "Three rounds, three different kinds, each genuinely repaired. The class law must not fire: it exists to catch renaming, not progress.",
      "repair_rounds": 2,
      "rounds": [
        {
          "verdict": "FAIL",
          "digest": "a",
          "findings": [
            {
              "id": "f1",
              "class": "seal.pinning",
              "summary": "the seal is not pinned"
