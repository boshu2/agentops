{
  "schema_version": 1,
  "id": "agentops-core.distribution-install-update",
  "name": "AgentOps Distribution Install and Update Canary",
  "description": "Offline public canary for the AgentOps 4 install surface (ao skills link), release bundle coherence, Windows ao installer smoke wiring, and public install docs.",
  "practices": ["llm-eval-harness", "ai-assisted-dev"],
  "domain": "mixed",
  "visibility": "public_canary",
  "tier": "deterministic",
  "owners": ["agentops"],
  "tags": ["canary", "offline", "install", "update", "distribution", "codex", "windows", "homebrew"],
  "allowed_runtimes": ["shell", "static"],
  "environment": {
    "offline_required": true,
    "network": "forbidden",
    "scrub_env_prefixes": ["AGENTOPS_RPI_RUNTIME", "ANTHROPIC_", "OPENAI_"],
    "timeout_seconds": 180
  },
  "scoring": {
    "aggregate_threshold": 1,
    "dimensions": [
      {"name": "correctness", "weight": 2, "threshold": 1, "critical": true},
      {"name": "runtime_compatibility", "weight": 2, "threshold": 1, "critical": true},
      {"name": "process_adherence", "weight": 1, "threshold": 1},
      {"name": "artifact_quality", "weight": 1, "threshold": 1},
      {"name": "safety", "weight": 1, "threshold": 1, "critical": true}
    ]
  },
  "baseline_policy": {"mode": "compare", "baseline_path": ".agents/evals/baselines/agentops-core.distribution-install-update.baseline.json", "blocking_gate": "none"},
  "cases": [
    {
      "id": "shell-installer-smoke",
      "title": "install surface smoke passes with a local ao binary",
      "kind": "command",
      "objective": "Protect install-bd, tombstone installers, ao skills link wiring, and installed ao command registration.",
      "runtime": "shell",
      "timeout_seconds": 180,
      "inputs": {
        "cwd": "../..",
        "shell": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; (cd cli && env -u AGENTOPS_RPI_RUNTIME go build -o \"$tmp/ao\" ./cmd/ao); PATH=\"$tmp:$PATH\" bash tests/install/test-install-smoke.sh"
      },
      "expectations": [
        {"type": "exit_code", "value": 0},
        {"type": "stdout_contains", "value": "Install Surface Smoke Tests"},
        {"type": "stdout_contains", "value": "tombstone exits nonzero"},
        {"type": "stdout_contains", "value": "Results:"}
      ],
      "dimensions": ["correctness", "runtime_compatibility", "safety"],
      "critical": true
    },
    {
      "id": "codex-source-link-path",
      "title": "Codex runtime smoke uses ao skills link",
      "kind": "command",
      "objective": "Protect Codex source-link install smoke and tombstone refusal of the old plugin installer.",
      "runtime": "shell",
      "timeout_seconds": 240,
      "inputs": {
        "cwd": "../..",
        "shell": "bash tests/skills/test-runtime-codex-smoke.sh"
      },
      "expectations": [
        {"type": "exit_code", "value": 0},
        {"type": "stdout_contains", "value": "ao skills link succeeds"},
        {"type": "stdout_contains", "value": "tombstone exits nonzero"}
      ],
      "dimensions": ["correctness", "runtime_compatibility", "process_adherence", "artifact_quality"],
      "critical": true
    },
    {
      "id": "codex-release-bundle-and-manifests",
      "title": "Codex release bundle and plugin manifests are coherent",
      "kind": "command",
      "objective": "Protect archive-time Codex bundle coherence and plugin marketplace schema validation.",
      "runtime": "shell",
      "timeout_seconds": 240,
      "inputs": {
        "cwd": "../..",
        "shell": "bash tests/scripts/test-codex-install-bundle.sh && bash scripts/validate-codex-install-bundle.sh && bash scripts/validate-manifests.sh --repo-root ."
      },
      "expectations": [
        {"type": "exit_code", "value": 0},
        {"type": "stdout_contains", "value": "Results: 2 PASS, 0 FAIL"},
        {"type": "stdout_contains", "value": "Codex install bundle validation OK"}
      ],
      "dimensions": ["correctness", "artifact_quality", "process_adherence"],
      "critical": true
    },
    {
      "id": "windows-installer-smoke-wiring",
      "title": "Windows installer smoke remains wired into blocking CI",
      "kind": "artifact_check",
      "objective": "Keep native Windows PowerShell ao install, skills link, doctor hints, and Windows-sensitive Go tests wired into validate.yml.",
      "expectations": [
        {"type": "artifact_contains", "target": "../../tests/windows/test-windows-smoke.ps1", "value": "install-ao.ps1"},
        {"type": "artifact_contains", "target": "../../tests/windows/test-windows-smoke.ps1", "value": "skills link"},
        {"type": "artifact_contains", "target": "../../tests/windows/test-windows-smoke.ps1", "value": "$builtAO doctor"},
        {"type": "artifact_contains", "target": "../../.github/workflows/validate.yml", "value": "windows-smoke"},
        {"type": "artifact_contains", "target": "../../.github/workflows/validate.yml", "value": ".\\tests\\windows\\test-windows-smoke.ps1"}
      ],
      "dimensions": ["runtime_compatibility", "process_adherence", "artifact_quality"],
      "critical": true
    },
    {
      "id": "public-install-docs-current",
      "title": "public install docs preserve supported distribution commands",
      "kind": "artifact_check",
      "objective": "Keep README and migration docs aligned on brew + ao skills link.",
      "expectations": [
        {"type": "artifact_contains", "target": "../../README.md", "value": "ao skills link"},
        {"type": "artifact_contains", "target": "../../README.md", "value": "brew tap boshu2/agentops https://github.com/boshu2/homebrew-agentops"},
        {"type": "artifact_contains", "target": "../../docs/MIGRATION.md", "value": "ao skills link"},
        {"type": "artifact_contains", "target": "../../docs/install-day2-ops.md", "value": "ao skills link"}
      ],
      "dimensions": ["process_adherence", "artifact_quality", "runtime_compatibility"]
    },
    {
      "id": "skill-refresh-install-contract",
      "title": "skill refresh uses ao skills link (no 3.x curl installer)",
      "kind": "artifact_check",
      "objective": "Protect the supported latest-source refresh path after 3.x plugin installers were tombstoned.",
      "expectations": [
        {"type": "artifact_contains", "target": "../../scripts/refresh-codex-local.sh", "value": "skills link"},
        {"type": "artifact_contains", "target": "../../scripts/install.sh", "value": "ao skills link"},
        {"type": "artifact_contains", "target": "../../skills/bootstrap/SKILL.md", "value": "installing or invoking"}
      ],
      "dimensions": ["process_adherence", "artifact_quality", "runtime_compatibility", "safety"]
    }
  ]
}
